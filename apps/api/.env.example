# API server listening at : http://localhost:3001
# Copy this file to `.env` in this same folder and fill in the WS endpoints.

# WebSocket endpoints for chain listener (Uniswap / Swap parsing)
ETH_WS_URL=
BASE_WS_URL=
OP_WS_URL=
ARB_WS_URL=
BNB_WS_URL=

# Optional: allowed CORS origins, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Live execution (Arbitrum only, minimal swap support)
RPC_URL=
PRIVATE_KEY=

