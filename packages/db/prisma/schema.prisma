datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

/// 运行时配置 JSON，与 `EngineRuntimeConfig` 对齐（含 minSignalNotionalUsdt 等字段）。
model Watcher {
  id        String   @id @default(cuid())
  address   String
  chain     String
  status    String // 运行状态：RUNNING（运行中）/ STOPPED（已停止）
  config    Json
  createdAt DateTime @default(now())

  trades Trade[]
  events Event[]

  @@index([address, chain])
}

model Trade {
  id         String   @id @default(cuid())
  address    String
  token      String
  side       String // 方向：BUY / SELL
  size       Float

  entryPrice Float
  exitPrice  Float?

  pnl        Float?

  status     String // 成交状态：OPEN（持仓中）/ CLOSED（已平仓）

  txHash     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  watcherId String
  watcher   Watcher @relation(fields: [watcherId], references: [id], onDelete: Cascade)

  @@unique([txHash, address])
  @@index([watcherId])
  @@index([address])
  @@index([status])
  @@index([address, token])
}

/// message 展示；data 结构化分析字段。
model Event {
  id      String @id @default(cuid())
  type    String // 事件类型：SIGNAL / EXECUTION / ERROR
  message String
  data    Json?

  txHash String?
  stage  String?

  createdAt DateTime @default(now())

  watcherId String?
  watcher   Watcher? @relation(fields: [watcherId], references: [id], onDelete: SetNull)

  @@index([watcherId])
  @@index([createdAt])
}
