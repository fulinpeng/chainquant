datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

/// 监听实例：与 API `Watcher.status`（RUNNING / STOPPED）对齐；运行时配置可后续用独立表或 Json 字段扩展。
model Watcher {
  id        String   @id @default(cuid())
  address   String
  chain     String
  status    String // RUNNING / STOPPED
  createdAt DateTime @default(now())

  trades Trade[]
  events Event[]

  @@index([address, chain])
}

/// 成交：侧向用字符串存（如 BUY/SELL；引擎 LONG/SHORT 在写入层映射）；时间与风控字段可按需再加列迁移。
model Trade {
  id         String   @id @default(cuid())
  address    String
  token      String
  side       String // BUY / SELL
  size       Float

  entryPrice Float
  exitPrice  Float?

  pnl        Float?

  status     String // OPEN / CLOSED

  txHash     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  watcherId String
  watcher   Watcher @relation(fields: [watcherId], references: [id], onDelete: Cascade)

  @@index([watcherId])
  @@index([address, token])
}

/// 引擎 / 执行流水：类型与 stage 均用字符串，便于新增枚举值而不改 schema。
model Event {
  id      String @id @default(cuid())
  type    String // SIGNAL / EXECUTION / ERROR
  message String

  txHash String?
  stage  String? // quote_failed / send_tx_failed / ...

  createdAt DateTime @default(now())

  watcherId String?
  watcher   Watcher? @relation(fields: [watcherId], references: [id], onDelete: SetNull)

  @@index([watcherId])
  @@index([createdAt])
}
